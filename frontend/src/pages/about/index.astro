---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description="关于我和这个导航站">
  <div id="about-container" class="max-w-2xl mx-auto">
    <div class="text-center mb-10">
      <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-4xl mb-4 overflow-hidden">
        <img id="about-avatar" class="w-full h-full object-cover hidden" alt="头像" width="96" height="96" />
        <span id="about-avatar-fallback">👨‍💻</span>
      </div>
      <h1 id="about-title" class="text-3xl font-bold tracking-tight mb-2">加载中...</h1>
      <p id="about-subtitle" class="text-gray-500 dark:text-gray-400"></p>
    </div>

    <div id="about-bio" class="prose dark:prose-invert max-w-none mb-8"></div>

    <div class="mb-8">
      <h2 class="text-xl font-semibold mb-4">技术栈</h2>
      <div id="about-skills" class="flex flex-wrap gap-2"></div>
    </div>

    <div>
      <h2 class="text-xl font-semibold mb-4">社交链接</h2>
      <div id="about-socials" class="flex flex-wrap gap-4"></div>
    </div>
  </div>
</BaseLayout>

<script>
  function esc(str: string): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  async function loadAbout() {
    const apiBase = import.meta.env.PUBLIC_API_BASE_URL;
    const container = document.getElementById('about-container');
    if (!apiBase || !container) return;

    let data: any = null;
    try {
      const res = await fetch(apiBase + '/api/about', { signal: AbortSignal.timeout(5000) });
      if (res.ok) {
        const json = await res.json();
        data = json && json.data;
      }
    } catch (e) {
      console.warn('[about] 加载失败', e);
    }

    if (!data) {
      container.innerHTML = `
        <div class="py-16 text-center">
          <div class="text-4xl mb-3">⚠️</div>
          <p class="text-gray-500 dark:text-gray-400">加载失败</p>
        </div>`;
      return;
    }

    const avatar = document.getElementById('about-avatar') as HTMLImageElement | null;
    const avatarFallback = document.getElementById('about-avatar-fallback');
    if (data.avatar) {
      avatar!.src = data.avatar;
      avatar!.classList.remove('hidden');
      if (avatarFallback) avatarFallback.style.display = 'none';
    }

    const titleEl = document.getElementById('about-title');
    if (titleEl) titleEl.textContent = data.aboutTitle || '你好，我是';

    const subtitleEl = document.getElementById('about-subtitle');
    if (subtitleEl) subtitleEl.textContent = data.aboutSubtitle || '';

    const bioEl = document.getElementById('about-bio');
    if (bioEl) {
      bioEl.innerHTML = (data.aboutBio || '')
        .split(/\n+/)
        .map((p: string) => `<p>${esc(p)}</p>`)
        .join('');
    }

    const skillsEl = document.getElementById('about-skills');
    if (skillsEl) {
      const skills: string[] = Array.isArray(data.skills) ? data.skills : [];
      skillsEl.innerHTML = skills
        .map(
          (s) =>
            `<span class="rounded-lg bg-blue-50 dark:bg-blue-900/30 px-3 py-1 text-sm font-medium text-blue-600 dark:text-blue-400">${esc(s)}</span>`
        )
        .join('');
    }

    const socialsEl = document.getElementById('about-socials');
    if (socialsEl) {
      const socials: any[] = Array.isArray(data.socials) ? data.socials : [];
      socialsEl.innerHTML = socials
        .map((s) => {
          const label = typeof s === 'string' ? s : (s && (s.label || s.name)) || '';
          const url = typeof s === 'string' ? '' : (s && s.url) || '';
          if (!label) return '';
          if (!url) return `<span class="text-sm text-gray-500 dark:text-gray-400">${esc(label)}</span>`;
          return `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-800 px-4 py-2 text-sm font-medium hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">${esc(label)}</a>`;
        })
        .join('');
    }
  }

  loadAbout();
</script>
