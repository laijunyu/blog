---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Skeleton from '../../components/Skeleton.astro';
---

<BaseLayout title="游戏" description="精选小游戏合集，在线即开即玩">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight mb-2">游戏</h1>
    <p id="game-count" class="text-gray-500 dark:text-gray-400">加载中...</p>
  </div>

  <div id="game-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <Skeleton count={3} type="card" />
  </div>
</BaseLayout>

<script>
  import { fetchAllGames } from '../../services/games';
  import type { GameItem } from '../../types';

  const errorHTML = `
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="text-4xl mb-3">⚠️</div>
      <p class="text-gray-500 dark:text-gray-400 mb-4">加载失败</p>
      <button id="retry-btn" type="button" class="cursor-pointer rounded-lg border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">重试</button>
    </div>`;

  const emptyHTML = `
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="text-4xl mb-3">📭</div>
      <p class="text-gray-500 dark:text-gray-400">暂无游戏</p>
    </div>`;

  function cardHTML(game: GameItem): string {
    return `
      <div class="game-card group block rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-green-200/50 dark:hover:shadow-green-900/50 cursor-pointer" data-slug="${game.slug || ''}" data-src="${game.src}" data-title="${game.title}">
        <div class="text-4xl mb-3">${game.icon}</div>
        <h3 class="text-lg font-semibold mb-1 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">${game.title}</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-2">${game.description}</p>
        <div class="flex flex-wrap gap-1.5 mb-3">
          ${game.tags
            .map(
              (t) =>
                `<span class="inline-block rounded-md bg-green-50 dark:bg-green-900/30 px-2 py-0.5 text-xs font-medium text-green-600 dark:text-green-400">${t}</span>`
            )
            .join('')}
        </div>
        <div class="text-xs font-medium text-green-600 dark:text-green-400 pointer-events-none">▶ 开始玩</div>
      </div>`;
  }

  function openGame(card: HTMLElement) {
    const slug = card.dataset.slug || '';
    const src = card.dataset.src || '';
    if (slug) {
      window.location.href = `/games/run#${slug}`;
    } else if (src) {
      window.open(src, '_blank', 'noopener,noreferrer');
    }
  }

  async function loadGames() {
    const grid = document.getElementById('game-grid') as HTMLElement | null;
    const countEl = document.getElementById('game-count') as HTMLElement | null;
    if (!grid) return;

    const games = await fetchAllGames();

    if (games === null) {
      grid.innerHTML = errorHTML;
      document.getElementById('retry-btn')?.addEventListener('click', loadGames);
      return;
    }

    if (games.length === 0) {
      grid.innerHTML = emptyHTML;
      if (countEl) countEl.textContent = '暂无游戏';
      return;
    }

    if (countEl) countEl.textContent = `共 ${games.length} 款游戏`;
    grid.innerHTML = games.map(cardHTML).join('');
    grid.querySelectorAll('.game-card').forEach((card) => {
      card.addEventListener('click', () => openGame(card as HTMLElement));
    });
  }

  loadGames();
</script>
