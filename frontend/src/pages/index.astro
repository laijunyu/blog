---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';

const sections = [
  {
    icon: '📝',
    title: '博客',
    description: '技术文章、随笔记录，分享学习与思考',
    stat: '···',
    statId: 'stat-blog',
    url: '/blog',
    accent: '#3b82f6',
  },
  {
    icon: '🎮',
    title: '游戏',
    description: '精选小游戏合集，在线即开即玩',
    stat: '···',
    statId: 'stat-games',
    url: '/games',
    accent: '#22c55e',
  },
  {
    icon: '🛠️',
    title: '工具',
    description: '实用在线工具和常用资源导航',
    stat: '···',
    statId: 'stat-tools',
    url: '/tools',
    accent: '#f97316',
  },
  {
    icon: '🔗',
    title: '友链',
    description: '友情链接，发现更多有趣的站点',
    stat: '···',
    statId: 'stat-links',
    url: '/links',
    accent: '#a855f7',
  },
];
---

<BaseLayout title="首页">
  <section class="py-8 sm:py-16">
    <div class="text-center mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-3">探索导航站</h1>
      <p class="text-gray-500 dark:text-gray-400 text-lg">一站式访问博客、游戏、工具和友链</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {sections.map((section) => (
        <SectionCard
          icon={section.icon}
          title={section.title}
          description={section.description}
          stat={section.stat}
          statId={section.statId}
          url={section.url}
          accent={section.accent}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchSiteMeta } from '../services/site';

  const statIds = ['stat-blog', 'stat-games', 'stat-tools', 'stat-links'];

  async function loadStats() {
    const meta = await fetchSiteMeta();

    if (meta) {
      const values = [meta.postCount, meta.gameCount, meta.toolCount, meta.linkCount];
      statIds.forEach((id, i) => {
        const el = document.getElementById(id);
        if (el) el.textContent = String(values[i]);
      });
      return;
    }

    statIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.textContent = '探索 →';
    });
  }

  loadStats();
</script>
