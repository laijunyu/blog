---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Skeleton from '../../components/Skeleton.astro';
import ErrorState from '../../components/ErrorState.astro';
import EmptyState from '../../components/EmptyState.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<BaseLayout title="博客" description="技术文章、随笔记录，分享学习与思考">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight mb-2">博客</h1>
    <p id="post-count" class="text-gray-500 dark:text-gray-400">加载中...</p>
  </div>

  <div class="mb-6 space-y-4">
    <input
      id="search-input"
      type="text"
      placeholder="搜索标题或标签..."
      class="w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2.5 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-colors"
    />
    <div id="tag-bar" class="flex flex-wrap gap-2"></div>
    <p id="search-count" class="text-sm text-gray-500 dark:text-gray-400"></p>
  </div>

  <div id="post-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    <Skeleton count={6} type="card" />
  </div>

  <AdUnit slot="YOUR_AD_SLOT_ID" />
</BaseLayout>

<script>
  import { fetchAllPosts } from '../../services/posts';
  import type { PostItem } from '../../types';
  import { formatDate } from '../../utils/format';

  const errorHTML = `
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="text-4xl mb-3">⚠️</div>
      <p class="text-gray-500 dark:text-gray-400 mb-4">加载失败</p>
      <button id="retry-btn" type="button" class="cursor-pointer rounded-lg border border-gray-300 dark:border-gray-600 px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">重试</button>
    </div>`;

  const emptyHTML = `
    <div class="flex flex-col items-center justify-center py-16 text-center">
      <div class="text-4xl mb-3">📭</div>
      <p class="text-gray-500 dark:text-gray-400">暂无文章</p>
    </div>`;

  let allPosts: PostItem[] = [];
  const activeTags = new Set<string>();

  const grid = document.getElementById('post-grid') as HTMLElement | null;
  const countEl = document.getElementById('post-count') as HTMLElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const tagBar = document.getElementById('tag-bar') as HTMLElement | null;
  const searchCountEl = document.getElementById('search-count') as HTMLElement | null;

  function renderCards(list: PostItem[]) {
    if (!grid) return;
    grid.innerHTML = list
      .map(
        (post) => `
      <a href="/blog/${post.slug}/" class="group block rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:shadow-gray-200/50 dark:hover:shadow-gray-900/50">
        <h2 class="text-lg font-semibold mb-2 line-clamp-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">${post.pinned ? '<span class="inline-block align-middle bg-blue-600 text-white text-xs px-1.5 py-0.5 rounded mr-1.5">置顶</span>' : ''}${post.title}</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 line-clamp-2">${post.summary}</p>
        <div class="flex flex-wrap gap-1.5 mb-3">
          ${post.tags
            .map(
              (t) =>
                `<span class="inline-block rounded-md bg-blue-50 dark:bg-blue-900/30 px-2 py-0.5 text-xs font-medium text-blue-600 dark:text-blue-400">${t}</span>`
            )
            .join('')}
        </div>
        <div class="flex items-center justify-between">
          <time datetime="${formatDate(post.date)}" class="text-xs text-gray-400 dark:text-gray-500">${formatDate(post.date)}</time>
          <span class="text-xs text-gray-400 dark:text-gray-500">阅读数 ${post.views ?? 0}</span>
        </div>
      </a>`
      )
      .join('');
  }

  function renderTagBar() {
    if (!tagBar) return;
    tagBar.innerHTML = '';

    const allButton = document.createElement('button');
    allButton.textContent = '全部';
    allButton.className =
      'rounded-lg px-3 py-1 text-xs font-medium transition-colors cursor-pointer ' +
      (activeTags.size === 0
        ? 'bg-blue-600 text-white'
        : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700');
    allButton.addEventListener('click', () => {
      activeTags.clear();
      filter();
    });
    tagBar.appendChild(allButton);

    const allTags = [...new Set(allPosts.flatMap((p) => p.tags))].sort();
    allTags.forEach((tag) => {
      const btn = document.createElement('button');
      btn.textContent = tag;
      btn.className =
        'rounded-lg px-3 py-1 text-xs font-medium transition-colors cursor-pointer ' +
        (activeTags.has(tag)
          ? 'bg-blue-600 text-white'
          : 'bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/50');
      btn.addEventListener('click', () => {
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
        } else {
          activeTags.add(tag);
        }
        filter();
      });
      tagBar.appendChild(btn);
    });
  }

  function filter() {
    const query = (input?.value || '').toLowerCase();

    const filtered = allPosts.filter((post) => {
      const textMatch =
        !query ||
        post.title.toLowerCase().includes(query) ||
        post.tags.some((t) => t.toLowerCase().includes(query));
      const tagMatch = activeTags.size === 0 || post.tags.some((t) => activeTags.has(t));
      return textMatch && tagMatch;
    });

    renderCards(filtered);
    renderTagBar();
    if (searchCountEl) {
      searchCountEl.textContent = `${filtered.length} / ${allPosts.length} 篇`;
    }
  }

  async function loadPosts() {
    if (!grid) return;

    const posts = await fetchAllPosts();

    if (posts === null) {
      grid.innerHTML = errorHTML;
      document.getElementById('retry-btn')?.addEventListener('click', loadPosts);
      return;
    }

    if (posts.length === 0) {
      grid.innerHTML = emptyHTML;
      if (countEl) countEl.textContent = '暂无文章';
      return;
    }

    allPosts = posts;
    if (countEl) countEl.textContent = `共 ${posts.length} 篇文章`;
    renderCards(posts);
    renderTagBar();
    if (searchCountEl) {
      searchCountEl.textContent = `${posts.length} / ${posts.length} 篇`;
    }
    input?.addEventListener('input', filter);
  }

  loadPosts();
</script>
