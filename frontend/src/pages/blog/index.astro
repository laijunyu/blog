---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSearch from '../../components/BlogSearch.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);

posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

const postsJSON = JSON.stringify(
  posts.map((post) => ({
    title: post.data.title,
    url: `/blog/${post.id}`,
    date: post.data.date.toISOString(),
    summary: post.data.summary,
    tags: post.data.tags,
  }))
);
---

<BaseLayout title="博客" description="技术文章、随笔记录，分享学习与思考">
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight mb-2">博客</h1>
    <p class="text-gray-500 dark:text-gray-400">
      共 {posts.length} 篇文章
    </p>
  </div>

  <BlogSearch />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
    {posts.map((post) => (
      <BlogCard
        title={post.data.title}
        url={`/blog/${post.id}`}
        date={post.data.date}
        summary={post.data.summary}
        tags={post.data.tags}
      />
    ))}
  </div>
</BaseLayout>

<script define:vars={{ postsJSON: postsJSON, allTagsJSON: JSON.stringify(allTags) }}>
  window.__BLOG_POSTS__ = JSON.parse(postsJSON);
  window.__ALL_TAGS__ = JSON.parse(allTagsJSON);
</script>